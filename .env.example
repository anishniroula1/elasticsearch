# Local Docker uses the OpenSearch container.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_AUTH_MODE=none
OPENSEARCH_SERVICE=es
OPENSEARCH_INDEX=ner_entity_occurrences-v1
OPENSEARCH_ALIAS=ner_entity_occurrences

# Fill this role ARN and change auth mode to iam when connecting to AWS.
AWS_REGION=us-east-1
IAM_ACCESS_ROLE=

AUTO_SEED=true
SEED_COUNT=10000
